<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>P7.WinUISample</AssemblyName>
    <RootNamespace>P7.WinUISample</RootNamespace>
    <StartupObject>P7.WinUISample.Program</StartupObject>
    <BaseOutputPath>../../build/managed/P7.WinUISample/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>../../build/managed/P7.WinUISample/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../adapters/winui/AuroraGlass.WinUI/AuroraGlass.WinUI.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <Target Name="CopyAuroraGlassNative" AfterTargets="Build">
    <Copy
      SourceFiles="../../build/Debug/AuroraGlassWinUIInterop.dll;../../build/Debug/AuroraGlassWpfInterop.dll"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>