<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>P6.WpfCompositionProof</AssemblyName>
    <RootNamespace>P6.WpfCompositionProof</RootNamespace>
    <BaseOutputPath>../../build/managed/P6.WpfCompositionProof/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>../../build/managed/P6.WpfCompositionProof/obj/</BaseIntermediateOutputPath>
    <StartupObject>P6.WpfCompositionProof.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../adapters/wpf/AuroraGlass.Wpf/AuroraGlass.Wpf.csproj" />
  </ItemGroup>

  <Target Name="CopyAuroraGlassNative" AfterTargets="Build">
    <Copy SourceFiles="../../build/Debug/AuroraGlassWpfInterop.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="../../shaders/background.hlsl;../../shaders/blur.hlsl;../../shaders/fullscreen_triangle.hlsl;../../shaders/glass.hlsl"
          DestinationFolder="$(OutDir)shaders" SkipUnchangedFiles="true" />
  </Target>
</Project>
