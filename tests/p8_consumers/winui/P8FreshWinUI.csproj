<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <StartupObject>P8FreshWinUI.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />

    <Reference Include="AuroraGlass.WinUI">
      <HintPath>sdk\AuroraGlass.WinUI.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <None Include="sdk\AuroraGlassWinUIInterop.dll"
          Link="AuroraGlassWinUIInterop.dll"
          CopyToOutputDirectory="PreserveNewest" />

    <None Include="sdk\AuroraGlassWpfInterop.dll"
          Link="AuroraGlassWpfInterop.dll"
          CopyToOutputDirectory="PreserveNewest" />

    <None Include="sdk\shaders\**\*"
          Link="shaders\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>